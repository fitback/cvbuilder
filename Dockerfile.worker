FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/backend/package.json packages/backend/

RUN npm ci

COPY packages/shared packages/shared
COPY packages/backend packages/backend

RUN npm run build -w packages/shared
RUN npm run build -w packages/backend
RUN npm run db:generate -w packages/backend

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium dumb-init \
    && rm -rf /var/lib/apt/lists/*
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/backend/package.json ./packages/backend/
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build /app/packages/backend/prompts ./packages/backend/prompts

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "packages/backend/dist/resumes/parse.worker.js"]
