# cvbuilder 生产环境变量
# 复制此文件为 .env.prod 并填入真实值

# 数据库
DB_PASSWORD=your-strong-db-password-here

# Redis (内网通信，保持默认即可)

# DeepSeek AI
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JWT/Session 密钥 (openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret
SESSION_SECRET=change-me-session-secret

# 支付宝当面付
ALIPAY_APP_ID=2021xxxxxxxxxx
ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_NOTIFY_URL=https://your-domain.com/api/recharges/notify

# 前端生产地址 (用于 CORS)
CORS_ORIGIN=https://your-domain.com
